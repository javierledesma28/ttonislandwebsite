# T-TON Island — environment variables template
# Copy to .env and fill the placeholders. .env is gitignored.

DATABASE_URL="file:./tton.db"

# Auth.js v5 — generate with: npx auth secret
AUTH_SECRET=""

# Discord OAuth credentials
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# Email notifications — SMTP via Office 365 (custom domain)
SMTP_HOST="smtp.office365.com"
SMTP_PORT="587"
SMTP_USER=""        # ej: javier@t28.io
SMTP_PASSWORD=""    # App Password si MFA activo
SMTP_FROM="TTON Despedida <noreply@t28.io>"

# Base URL — usada para construir links de moderación
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
