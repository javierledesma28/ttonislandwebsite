// T-TON Island — DB schema
// Mensajes de comunidad + Auth.js (NextAuth v5)
// Storage: SQLite (file en Docker volume del VPS)

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  // native = Windows local dev. linux-musl-openssl-3.0.x = Alpine container (prod).
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// NextAuth.js v5 — modelos requeridos
// ─────────────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  name            String?
  email           String?   @unique
  emailVerified   DateTime?
  image           String?
  // TTON-specific
  discordId       String?   @unique
  discordUsername String?
  isStaff         Boolean   @default(false)
  isAdmin         Boolean   @default(false)
  // Relations
  accounts        Account[]
  sessions        Session[]
  messages        Message[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────
// TTON Mensajes — el corazón social de la despedida
// ─────────────────────────────────────────────

model Message {
  id            String   @id @default(cuid())
  userId        String
  content       String
  createdAt     DateTime @default(now())
  // Flags
  isHidden      Boolean  @default(false) // moderation
  isHighlighted Boolean  @default(false) // staff pinned / highlighted
  // Snapshot at write time so display survives user updates
  authorName    String
  authorAvatar  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId])
}
